/* ============================================
   Senaka Oshitaru Corporate Site - Stylesheet
   Concept: Tech Blue × Deep Navy / Dark UI
   ============================================ */

/* ===== Reset / Base ===== */
*,
*::before,
*::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

:root {
    /* Color tokens */
    --color-bg: #020714;
    --color-bg-2: #050d20;
    --color-bg-3: #08142b;
    --color-bg-4: #0c1a35;
    --color-surface: rgba(12, 26, 53, 0.55);
    --color-border: rgba(120, 160, 220, 0.18);
    --color-border-strong: rgba(140, 180, 230, 0.35);

    --color-text: #f2f5fa;
    --color-text-muted: #b0bcd2;
    --color-text-dim: #7a8aa8;

    --color-accent: #4f8cff;       /* Tech Blue */
    --color-accent-2: #00d2ff;     /* Cyan */
    --color-accent-3: #7b5bff;     /* Violet */
    --color-accent-4: #ff5bd1;     /* Magenta */
    --color-deep-navy: #0a1f4a;

    --grad-accent: linear-gradient(120deg, #4f8cff 0%, #7b5bff 50%, #ff5bd1 100%);
    --grad-blue: linear-gradient(135deg, #00d2ff 0%, #4f8cff 100%);

    /* Typography */
    --font-en: 'Inter', sans-serif;
    --font-jp: 'Noto Sans JP', 'Hiragino Sans', 'Yu Gothic', sans-serif;
    --font-jp-serif: 'Noto Serif JP', 'Hiragino Mincho ProN', 'Yu Mincho', serif;

    /* Layout */
    --header-h: 84px;
    --container-w: 1240px;
    --gutter: 32px;

    /* Easing */
    --ease-out: cubic-bezier(0.22, 0.61, 0.36, 1);
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: var(--font-jp);
    color: var(--color-text);
    background: var(--color-bg);
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    overflow-x: hidden;
}

img {
    max-width: 100%;
    height: auto;
    display: block;
}

a {
    color: inherit;
    text-decoration: none;
    transition: color 0.3s var(--ease-out), opacity 0.3s var(--ease-out);
}

button {
    background: none;
    border: none;
    cursor: pointer;
    color: inherit;
    font-family: inherit;
}

ul {
    list-style: none;
}

.container {
    width: 100%;
    max-width: var(--container-w);
    margin: 0 auto;
    padding: 0 var(--gutter);
}

/* ===== Global Header ===== */
.global-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--header-h);
    z-index: 100;
    background: rgba(2, 7, 20, 0);
    backdrop-filter: blur(0px);
    transition: background 0.4s var(--ease-out), backdrop-filter 0.4s var(--ease-out), height 0.3s var(--ease-out);
}

.global-header.is-scrolled {
    background: rgba(2, 7, 20, 0.78);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--color-border);
    height: 68px;
}

.header-inner {
    height: 100%;
    max-width: 1480px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
}

.brand-logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-en);
    font-weight: 700;
    font-size: 18px;
    letter-spacing: 0.04em;
    white-space: nowrap;
}

.logo-mark {
    width: 32px;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

.logo-mark svg {
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 0 6px rgba(79, 140, 255, 0.5));
}

.logo-text {
    color: #fff;
}

.primary-nav ul {
    display: flex;
    gap: 36px;
}

.nav-link {
    font-family: var(--font-en);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.18em;
    color: var(--color-text);
    position: relative;
    padding: 6px 0;
}

.nav-link::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 0;
    height: 1px;
    background: var(--grad-accent);
    transform: translateX(-50%);
    transition: width 0.4s var(--ease-out);
}

.nav-link:hover::after,
.nav-link.is-active::after {
    width: 100%;
}

.nav-link:hover {
    color: #fff;
}

.contact-btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 11px 22px;
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    font-family: var(--font-en);
    font-size: 12px;
    letter-spacing: 0.18em;
    font-weight: 600;
    transition: all 0.3s var(--ease-out);
    background: rgba(8, 20, 43, 0.4);
}

.contact-btn:hover {
    background: var(--grad-accent);
    border-color: transparent;
    box-shadow: 0 8px 28px rgba(123, 91, 255, 0.4);
    transform: translateY(-2px);
}

.contact-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent-2);
    box-shadow: 0 0 10px var(--color-accent-2);
}

.menu-toggle {
    display: none;
    width: 36px;
    height: 36px;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    align-items: flex-end;
}

.menu-toggle span {
    display: block;
    width: 24px;
    height: 2px;
    background: #fff;
    transition: transform 0.3s var(--ease-out), opacity 0.3s var(--ease-out);
}

.menu-toggle.is-open span:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
}
.menu-toggle.is-open span:nth-child(2) {
    opacity: 0;
}
.menu-toggle.is-open span:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
    width: 24px;
}

.mobile-drawer {
    position: fixed;
    inset: 0;
    background: rgba(2, 7, 20, 0.97);
    backdrop-filter: blur(20px);
    z-index: 90;
    padding: calc(var(--header-h) + 40px) 32px 32px;
    transform: translateX(100%);
    transition: transform 0.4s var(--ease-out);
}

.mobile-drawer.is-open {
    transform: translateX(0);
}

.mobile-drawer ul {
    display: flex;
    flex-direction: column;
    gap: 28px;
}

.mobile-drawer a {
    font-family: var(--font-en);
    font-size: 22px;
    font-weight: 600;
    letter-spacing: 0.15em;
    display: block;
    padding: 8px 0;
    border-bottom: 1px solid var(--color-border);
}

/* ===== Hero Section ===== */
.hero-section {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
    display: flex;
    align-items: center;
    background: var(--color-bg);
}

.hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
}

.hero-bg-image {
    position: absolute;
    top: 0;
    right: -8%;
    width: 75%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0.92;
    animation: heroFloat 18s ease-in-out infinite;
    will-change: transform;
}

@keyframes heroFloat {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(-1%, -1.5%) scale(1.03); }
}

.hero-bg-overlay {
    position: absolute;
    inset: 0;
    background:
        linear-gradient(90deg, var(--color-bg) 0%, rgba(2, 7, 20, 0.65) 35%, rgba(2, 7, 20, 0.1) 65%, rgba(2, 7, 20, 0.45) 100%),
        radial-gradient(ellipse at 20% 50%, rgba(2, 7, 20, 0.9) 0%, transparent 60%);
}

.particle-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
}

.hero-content {
    position: relative;
    z-index: 2;
    max-width: 1480px;
    width: 100%;
    margin: 0 auto;
    padding: calc(var(--header-h) + 40px) 40px 80px;
}

.hero-title {
    font-family: var(--font-jp-serif);
    font-weight: 700;
    font-size: clamp(36px, 5.6vw, 78px);
    line-height: 1.25;
    letter-spacing: 0.01em;
    color: #fff;
    margin-bottom: 36px;
}

.ja-emphasis {
    position: relative;
    color: #fff;
}

.ja-emphasis.grad {
    background: var(--grad-accent);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
}

.grad {
    background: var(--grad-accent);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
}

.hero-title-line {
    display: block;
    overflow: hidden;
}

.hero-title-line span {
    display: inline-block;
}

.hero-subtitle {
    font-family: var(--font-jp);
    font-size: clamp(16px, 1.5vw, 20px);
    font-weight: 500;
    color: #fff;
    margin-bottom: 24px;
    letter-spacing: 0.05em;
    line-height: 1.7;
}

.sp-only { display: none; }

.hero-description {
    font-size: 14px;
    line-height: 2;
    color: var(--color-text-muted);
    margin-bottom: 48px;
    max-width: 460px;
}

.play-movie-btn {
    display: inline-flex;
    align-items: center;
    gap: 18px;
    padding: 0;
    color: #fff;
    transition: opacity 0.3s var(--ease-out);
}

.play-movie-btn:hover {
    opacity: 0.85;
}

.play-icon {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: 1px solid var(--color-border-strong);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    background: rgba(255, 255, 255, 0.04);
    transition: all 0.3s var(--ease-out);
    position: relative;
}

.play-icon::before {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 1px solid var(--color-accent);
    opacity: 0;
    animation: pulse 2.5s var(--ease-out) infinite;
}

@keyframes pulse {
    0% { transform: scale(0.95); opacity: 0.7; }
    100% { transform: scale(1.25); opacity: 0; }
}

.play-movie-btn:hover .play-icon {
    background: var(--grad-accent);
    border-color: transparent;
    box-shadow: 0 0 24px rgba(123, 91, 255, 0.5);
}

.play-icon i {
    margin-left: 3px;
}

.play-label {
    font-family: var(--font-en);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.2em;
}

/* Hero pagination */
.hero-pagination {
    position: absolute;
    right: 40px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
}

.hero-pagination .page-num {
    font-family: var(--font-en);
    font-size: 12px;
    letter-spacing: 0.15em;
    color: #fff;
    font-weight: 500;
}

.hero-pagination ul {
    display: flex;
    flex-direction: column;
    gap: 14px;
}

.hero-pagination li {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.25);
    transition: all 0.3s var(--ease-out);
}

.hero-pagination li.is-active {
    background: var(--color-accent-2);
    box-shadow: 0 0 10px var(--color-accent-2);
    transform: scale(1.3);
}

/* Scroll indicator */
.scroll-indicator {
    position: absolute;
    left: 28px;
    bottom: 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
}

.scroll-text {
    font-family: var(--font-en);
    font-size: 11px;
    letter-spacing: 0.3em;
    writing-mode: vertical-rl;
    color: var(--color-text-muted);
}

.scroll-line {
    width: 1px;
    height: 70px;
    background: linear-gradient(to bottom, var(--color-accent-2), transparent);
    position: relative;
    overflow: hidden;
}

.scroll-line::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 30%;
    background: var(--color-accent-2);
    animation: scrollMove 2.4s var(--ease-out) infinite;
}

@keyframes scrollMove {
    0% { transform: translateY(-100%); }
    100% { transform: translateY(330%); }
}

/* ===== Section Header ===== */
.section-header {
    margin-bottom: 64px;
}

.section-title {
    font-family: var(--font-en);
    font-size: clamp(36px, 4vw, 56px);
    font-weight: 800;
    letter-spacing: 0.01em;
    line-height: 1;
    color: #fff;
    margin-bottom: 12px;
}

.section-subtitle {
    font-size: 13px;
    color: var(--color-text-muted);
    letter-spacing: 0.15em;
    margin-bottom: 20px;
}

.section-divider {
    display: block;
    width: 50px;
    height: 2px;
    background: var(--grad-accent);
    border-radius: 1px;
}

/* ===== Service Section ===== */
.service-section {
    position: relative;
    padding: 120px 0 140px;
    background: var(--color-bg);
}

.service-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
        radial-gradient(circle at 80% 20%, rgba(79, 140, 255, 0.08) 0%, transparent 50%),
        radial-gradient(circle at 10% 80%, rgba(123, 91, 255, 0.06) 0%, transparent 55%);
    pointer-events: none;
}

.service-section .container {
    position: relative;
    z-index: 1;
}

.service-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    margin-bottom: 64px;
}

.service-grid.service-grid-3 {
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    margin-bottom: 0;
}

.service-card-num {
    position: absolute;
    top: 18px;
    left: 18px;
    z-index: 3;
    font-family: var(--font-en);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: #fff;
    padding: 5px 12px;
    background: rgba(2, 7, 20, 0.6);
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    backdrop-filter: blur(6px);
}

.service-card-catch {
    font-family: var(--font-jp);
    font-size: 14px;
    line-height: 1.7;
    color: #fff;
    font-weight: 600;
    margin-bottom: 16px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--color-border);
}

.service-card {
    position: relative;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    overflow: hidden;
    background: linear-gradient(180deg, rgba(12, 26, 53, 0.4) 0%, rgba(8, 20, 43, 0.7) 100%);
    transition: transform 0.5s var(--ease-out), border-color 0.5s var(--ease-out), box-shadow 0.5s var(--ease-out);
    cursor: pointer;
}

.service-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 4px;
    padding: 1px;
    background: var(--grad-accent);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.5s var(--ease-out);
    pointer-events: none;
}

.service-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 60px rgba(79, 140, 255, 0.18);
}

.service-card:hover::before {
    opacity: 1;
}

.service-card-image {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
}

.service-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease-out);
}

.service-card-image::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(2, 7, 20, 0) 50%, rgba(2, 7, 20, 0.85) 100%);
}

.service-card:hover .service-card-image img {
    transform: scale(1.08);
}

.service-card-body {
    padding: 28px 24px 32px;
    position: relative;
}

.service-card-title {
    font-family: var(--font-en);
    font-weight: 800;
    font-size: 20px;
    line-height: 1.2;
    letter-spacing: 0.02em;
    margin-bottom: 10px;
    color: #fff;
}

.service-card-jp {
    font-size: 12px;
    color: var(--color-accent-2);
    margin-bottom: 18px;
    letter-spacing: 0.1em;
}

.service-card-text {
    font-size: 13px;
    line-height: 1.9;
    color: var(--color-text-muted);
    min-height: 46px;
}

.service-grid-3 .service-card-text {
    min-height: auto;
}

.section-header-center {
    text-align: center;
}

.section-header-center .section-divider {
    margin: 0 auto;
}

.section-lead {
    font-size: 15px;
    line-height: 1.9;
    color: var(--color-text-muted);
    margin-top: 24px;
    max-width: 640px;
    margin-left: auto;
    margin-right: auto;
}

/* ===== Message Section (代表挨拶) ===== */
.message-section {
    position: relative;
    padding: 130px 0 140px;
    background: linear-gradient(180deg, var(--color-bg) 0%, #060f24 100%);
    overflow: hidden;
}

.message-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
        radial-gradient(circle at 15% 30%, rgba(79, 140, 255, 0.1) 0%, transparent 55%),
        radial-gradient(circle at 90% 80%, rgba(123, 91, 255, 0.08) 0%, transparent 55%);
    pointer-events: none;
}

.message-section .container {
    position: relative;
    z-index: 1;
}

.message-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 80px;
    align-items: center;
}

.message-headline {
    font-family: var(--font-jp-serif);
    font-size: clamp(22px, 2.4vw, 34px);
    font-weight: 700;
    line-height: 1.55;
    color: #fff;
    margin-bottom: 36px;
    letter-spacing: 0.02em;
}

.message-body p {
    font-size: 14px;
    line-height: 2.1;
    color: var(--color-text-muted);
    margin-bottom: 22px;
    letter-spacing: 0.02em;
}

.message-signature {
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 14px;
}

.sig-role {
    font-size: 12px;
    color: var(--color-text-dim);
    letter-spacing: 0.1em;
}

.sig-name {
    font-family: var(--font-jp-serif);
    font-size: 22px;
    font-weight: 700;
    color: #fff;
    letter-spacing: 0.06em;
}

.sig-name-en {
    font-family: var(--font-en);
    font-size: 12px;
    color: var(--color-text-muted);
    letter-spacing: 0.18em;
}

.message-visual {
    position: relative;
}

/* ===== CEO Portrait ===== */
.ceo-portrait {
    position: relative;
    max-width: 420px;
    margin: 0 auto;
}

.ceo-portrait-frame {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: 4px;
    overflow: hidden;
    background: linear-gradient(160deg, rgba(79, 140, 255, 0.18) 0%, rgba(123, 91, 255, 0.14) 50%, rgba(2, 7, 20, 0.85) 100%);
    box-shadow: 0 30px 80px rgba(79, 140, 255, 0.25);
}

.ceo-portrait-frame::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 4px;
    padding: 1px;
    background: var(--grad-accent);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0.7;
    pointer-events: none;
    z-index: 3;
}

.ceo-portrait-frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
        linear-gradient(180deg, rgba(2, 7, 20, 0) 55%, rgba(2, 7, 20, 0.85) 100%),
        radial-gradient(ellipse at 50% 30%, rgba(79, 140, 255, 0.18) 0%, transparent 60%);
    pointer-events: none;
    z-index: 2;
}

.ceo-portrait-frame img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
    z-index: 1;
    transition: transform 1.2s var(--ease-out);
}

.ceo-portrait:hover .ceo-portrait-frame img {
    transform: scale(1.04);
}

.ceo-portrait-glow {
    position: absolute;
    inset: -6%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(123, 91, 255, 0.28) 0%, transparent 60%);
    pointer-events: none;
    animation: glowPulse 5s ease-in-out infinite;
    z-index: 0;
}

.ceo-portrait-caption {
    position: absolute;
    left: 24px;
    bottom: 24px;
    z-index: 4;
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.ceo-name-jp {
    font-family: var(--font-jp-serif);
    font-size: 22px;
    font-weight: 700;
    color: #fff;
    letter-spacing: 0.06em;
}

.ceo-name-en {
    font-family: var(--font-en);
    font-size: 12px;
    color: var(--color-accent-2);
    letter-spacing: 0.2em;
    font-weight: 500;
}

.ceo-role {
    margin-top: 4px;
    font-family: var(--font-en);
    font-size: 11px;
    letter-spacing: 0.2em;
    color: var(--color-text-muted);
    padding-top: 8px;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
    display: inline-block;
    width: fit-content;
}

/* ===== Company Section ===== */
.company-section {
    background: var(--color-bg);
    padding: 120px 0 130px;
    position: relative;
    border-top: 1px solid var(--color-border);
}

.company-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 0%, rgba(79, 140, 255, 0.05) 0%, transparent 60%);
    pointer-events: none;
}

.company-table {
    max-width: 880px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
}

.company-row {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 32px;
    padding: 26px 8px;
    border-bottom: 1px solid var(--color-border);
    transition: background 0.3s var(--ease-out);
}

.company-row:first-child {
    border-top: 1px solid var(--color-border);
}

.company-row:hover {
    background: rgba(79, 140, 255, 0.04);
}

.company-row dt {
    font-family: var(--font-en);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.15em;
    color: var(--color-accent-2);
    position: relative;
    padding-left: 18px;
}

.company-row dt::before {
    content: '';
    position: absolute;
    left: 0;
    top: 9px;
    width: 8px;
    height: 8px;
    background: var(--color-accent-2);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--color-accent-2);
}

.company-row dd {
    font-size: 15px;
    line-height: 1.8;
    color: #fff;
    letter-spacing: 0.02em;
}

.company-biz-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.company-biz-list li {
    position: relative;
    padding-left: 18px;
}

.company-biz-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 12px;
    width: 8px;
    height: 1px;
    background: var(--color-accent-2);
}

/* ===== Contact CTA Section ===== */
.contact-section {
    position: relative;
    padding: 120px 0;
    overflow: hidden;
    background: linear-gradient(135deg, #050d20 0%, #0a0e2a 50%, #1a0d3a 100%);
}

.contact-bg {
    position: absolute;
    inset: 0;
    background:
        radial-gradient(ellipse at 20% 50%, rgba(79, 140, 255, 0.18) 0%, transparent 55%),
        radial-gradient(ellipse at 80% 50%, rgba(255, 91, 209, 0.12) 0%, transparent 55%);
    pointer-events: none;
}

.contact-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
        repeating-linear-gradient(45deg,
            transparent 0,
            transparent 60px,
            rgba(79, 140, 255, 0.04) 60px,
            rgba(79, 140, 255, 0.04) 61px);
}

.contact-inner {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 760px;
    margin: 0 auto;
}

.contact-eyebrow {
    font-family: var(--font-en);
    font-size: 13px;
    letter-spacing: 0.3em;
    color: var(--color-accent-2);
    margin-bottom: 20px;
    font-weight: 600;
}

.contact-headline {
    font-family: var(--font-jp-serif);
    font-size: clamp(24px, 2.8vw, 38px);
    font-weight: 700;
    line-height: 1.55;
    color: #fff;
    margin-bottom: 24px;
    letter-spacing: 0.02em;
}

.contact-text {
    font-size: 14px;
    line-height: 2;
    color: var(--color-text-muted);
    margin-bottom: 44px;
}

.contact-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 18px;
    padding: 22px 44px;
    background: var(--grad-accent);
    color: #fff;
    font-family: var(--font-jp);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.1em;
    border-radius: 999px;
    transition: transform 0.4s var(--ease-out), box-shadow 0.4s var(--ease-out);
    box-shadow: 0 14px 40px rgba(123, 91, 255, 0.4);
}

.contact-cta-btn:hover {
    transform: translateY(-4px);
    box-shadow: 0 22px 56px rgba(123, 91, 255, 0.6);
}

.contact-cta-btn i {
    transition: transform 0.4s var(--ease-out);
}

.contact-cta-btn:hover i {
    transform: translateX(6px);
}

.service-card-arrow {
    position: absolute;
    right: 24px;
    bottom: 28px;
    color: var(--color-text);
    font-size: 14px;
    transition: transform 0.4s var(--ease-out), color 0.3s var(--ease-out);
}

.service-card:hover .service-card-arrow {
    transform: translateX(6px);
    color: var(--color-accent-2);
}

/* View All button (general) */
.view-all-btn,
.view-more-btn,
.view-all-news {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-width: 240px;
    padding: 20px 26px;
    border: 1px solid var(--color-border-strong);
    color: #fff;
    font-family: var(--font-en);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.18em;
    transition: all 0.4s var(--ease-out);
    position: relative;
    overflow: hidden;
}

.view-all-btn::before,
.view-more-btn::before,
.view-all-news::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--grad-accent);
    transform: translateX(-101%);
    transition: transform 0.5s var(--ease-out);
    z-index: 0;
}

.view-all-btn > *,
.view-more-btn > *,
.view-all-news > * {
    position: relative;
    z-index: 1;
}

.view-all-btn:hover::before,
.view-more-btn:hover::before,
.view-all-news:hover::before {
    transform: translateX(0);
}

.view-all-btn:hover,
.view-more-btn:hover,
.view-all-news:hover {
    border-color: transparent;
}

/* ===== Vision Section ===== */
.vision-section {
    position: relative;
    padding: 130px 0 140px;
    background: linear-gradient(180deg, var(--color-bg) 0%, #0a0e2a 50%, #1a0d3a 100%);
    overflow: hidden;
}

.vision-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
        radial-gradient(ellipse at 70% 50%, rgba(123, 91, 255, 0.18) 0%, transparent 60%),
        radial-gradient(ellipse at 20% 30%, rgba(79, 140, 255, 0.1) 0%, transparent 55%);
    pointer-events: none;
}

.vision-section .container {
    position: relative;
    z-index: 1;
}

.vision-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
}

.vision-headline {
    font-family: var(--font-jp);
    font-size: clamp(24px, 2.5vw, 34px);
    font-weight: 700;
    line-height: 1.6;
    color: #fff;
    margin-bottom: 28px;
    letter-spacing: 0.02em;
}

.vision-description {
    font-size: 14px;
    line-height: 2;
    color: var(--color-text-muted);
    margin-bottom: 48px;
}

.vision-visual {
    position: relative;
    aspect-ratio: 1 / 1;
    max-width: 580px;
    margin-left: auto;
}

.earth-wrap {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    overflow: hidden;
    box-shadow: 0 0 60px rgba(123, 91, 255, 0.4);
    animation: earthSpin 60s linear infinite;
}

.earth-wrap::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    box-shadow: inset 0 0 80px rgba(123, 91, 255, 0.4);
    pointer-events: none;
}

.earth-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

@keyframes earthSpin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}

.earth-glow {
    position: absolute;
    inset: -10%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(123, 91, 255, 0.25) 0%, transparent 60%);
    pointer-events: none;
    animation: glowPulse 4s ease-in-out infinite;
}

@keyframes glowPulse {
    0%, 100% { opacity: 0.6; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.05); }
}

.vision-keywords {
    position: absolute;
    inset: 0;
    pointer-events: none;
}

.kw {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-en);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.2em;
    color: #fff;
}

.kw-line {
    width: 80px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-accent-2));
}

.kw-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent-2);
    box-shadow: 0 0 10px var(--color-accent-2);
    flex-shrink: 0;
}

.kw-1 { top: 16%; right: 8px; }
.kw-2 { top: 48%; right: 0; }
.kw-3 { top: 80%; right: 6px; }

.kw-1 .kw-line { width: 60px; }
.kw-2 .kw-line { width: 40px; }
.kw-3 .kw-line { width: 50px; }

.kw-text {
    text-shadow: 0 0 12px rgba(2, 7, 20, 0.9), 0 0 24px rgba(2, 7, 20, 0.7);
}

/* ===== News Section ===== */
.news-section {
    background: var(--color-bg);
    padding: 90px 0;
    position: relative;
    border-top: 1px solid var(--color-border);
}

.news-grid {
    display: grid;
    grid-template-columns: 220px 1fr auto;
    gap: 48px;
    align-items: center;
}

.news-header {
    margin-bottom: 0;
}

.news-list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
}

.news-item a {
    display: block;
    padding: 8px 0;
    position: relative;
    transition: opacity 0.3s var(--ease-out);
}

.news-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
}

.news-meta time {
    font-family: var(--font-en);
    font-size: 13px;
    color: var(--color-text);
    letter-spacing: 0.05em;
}

.news-tag {
    display: inline-block;
    padding: 3px 10px;
    font-size: 10px;
    border-radius: 2px;
    letter-spacing: 0.08em;
}

.tag-press {
    background: rgba(79, 140, 255, 0.18);
    color: var(--color-accent-2);
    border: 1px solid rgba(79, 140, 255, 0.3);
}

.tag-info {
    background: rgba(123, 91, 255, 0.18);
    color: #b69cff;
    border: 1px solid rgba(123, 91, 255, 0.3);
}

.news-title {
    font-size: 14px;
    line-height: 1.7;
    color: #fff;
    padding-right: 32px;
    transition: color 0.3s var(--ease-out);
}

.news-arrow {
    position: absolute;
    right: 0;
    bottom: 8px;
    font-size: 12px;
    color: var(--color-text-muted);
    transition: transform 0.3s var(--ease-out), color 0.3s var(--ease-out);
}

.news-item a:hover .news-arrow {
    transform: translateX(6px);
    color: var(--color-accent-2);
}

.news-item a:hover .news-title {
    color: var(--color-accent-2);
}

/* ===== Footer ===== */
.site-footer {
    position: relative;
    background: linear-gradient(180deg, #050d20 0%, #020714 100%);
    padding: 80px 0 32px;
    border-top: 1px solid var(--color-border);
    overflow: hidden;
}

.footer-bg {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 120px;
    background-image:
        radial-gradient(ellipse at 50% 100%, rgba(79, 140, 255, 0.08) 0%, transparent 70%);
    pointer-events: none;
}

.footer-bg::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
        repeating-linear-gradient(90deg,
            transparent 0,
            transparent 40px,
            rgba(79, 140, 255, 0.04) 40px,
            rgba(79, 140, 255, 0.04) 41px);
    mask-image: radial-gradient(ellipse at 50% 100%, #000 0%, transparent 70%);
}

.site-footer .container {
    position: relative;
    z-index: 1;
}

.footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 2fr 1fr;
    gap: 60px;
    margin-bottom: 60px;
}

.footer-brand .footer-logo {
    margin-bottom: 24px;
}

.footer-tagline {
    font-size: 14px;
    color: #fff;
    margin-bottom: 12px;
    font-weight: 500;
}

.footer-desc {
    font-size: 12px;
    line-height: 1.9;
    color: var(--color-text-muted);
    margin-bottom: 28px;
}

.social-list {
    display: flex;
    gap: 14px;
}

.social-list a {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    color: var(--color-text);
    transition: all 0.3s var(--ease-out);
}

.social-list a:hover {
    background: var(--grad-accent);
    border-color: transparent;
    color: #fff;
    transform: translateY(-3px);
}

.footer-nav-cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
}

.footer-col-title {
    font-family: var(--font-en);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.18em;
    margin-bottom: 22px;
    color: #fff;
    position: relative;
    padding-bottom: 14px;
}

.footer-col-title::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 24px;
    height: 1px;
    background: var(--color-accent-2);
}

.footer-col ul {
    display: flex;
    flex-direction: column;
    gap: 14px;
}

.footer-col a {
    font-size: 13px;
    color: var(--color-text-muted);
}

.footer-col a:hover {
    color: var(--color-accent-2);
}

.footer-contact-card {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: 36px 32px;
    border: 1px solid var(--color-border-strong);
    border-radius: 4px;
    background: rgba(8, 20, 43, 0.5);
    position: relative;
    overflow: hidden;
    min-height: 200px;
    transition: all 0.4s var(--ease-out);
}

.footer-contact-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--grad-accent);
    opacity: 0;
    transition: opacity 0.4s var(--ease-out);
}

.footer-contact-card > * {
    position: relative;
    z-index: 1;
}

.footer-contact-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 40px rgba(79, 140, 255, 0.2);
    border-color: transparent;
}

.footer-contact-card:hover::before {
    opacity: 0.95;
}

.footer-contact-title {
    font-family: var(--font-en);
    font-size: 22px;
    font-weight: 700;
    letter-spacing: 0.1em;
    margin-bottom: 12px;
    color: #fff;
}

.footer-contact-text {
    font-size: 12px;
    color: var(--color-text-muted);
    line-height: 1.8;
}

.footer-contact-card:hover .footer-contact-text {
    color: rgba(255, 255, 255, 0.9);
}

.footer-contact-arrow {
    position: absolute;
    right: 28px;
    bottom: 28px;
    font-size: 16px;
    color: #fff;
    transition: transform 0.3s var(--ease-out);
}

.footer-contact-card:hover .footer-contact-arrow {
    transform: translateX(8px);
}

.footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 28px;
    border-top: 1px solid var(--color-border);
    flex-wrap: wrap;
    gap: 16px;
}

.copyright {
    font-family: var(--font-en);
    font-size: 12px;
    color: var(--color-text-dim);
    letter-spacing: 0.05em;
}

.footer-bottom-links {
    display: flex;
    gap: 28px;
}

.footer-bottom-links a {
    font-size: 12px;
    color: var(--color-text-dim);
}

.footer-bottom-links a:hover {
    color: #fff;
}

/* ===== Reveal Animation ===== */
.reveal {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.9s var(--ease-out), transform 0.9s var(--ease-out);
}

.reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
}

/* Hero entrance animation */
.hero-title-line {
    opacity: 0;
    transform: translateY(50%);
    animation: heroTitleIn 1.1s var(--ease-out) forwards;
}

.hero-title-line:nth-child(1) { animation-delay: 0.2s; }
.hero-title-line:nth-child(2) { animation-delay: 0.4s; }

.hero-subtitle,
.hero-description,
.play-movie-btn {
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 0.9s var(--ease-out) forwards;
}

.hero-subtitle { animation-delay: 0.7s; }
.hero-description { animation-delay: 0.9s; }
.play-movie-btn { animation-delay: 1.1s; }

@keyframes heroTitleIn {
    to { opacity: 1; transform: translateY(0); }
}

@keyframes fadeUp {
    to { opacity: 1; transform: translateY(0); }
}

/* ===== Responsive ===== */
@media (max-width: 1100px) {
    .service-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .service-grid.service-grid-3 {
        grid-template-columns: repeat(2, 1fr);
    }

    .message-grid {
        grid-template-columns: 1fr;
        gap: 60px;
    }

    .message-text {
        order: 2;
    }

    .message-visual {
        order: 1;
    }

    .ceo-portrait {
        max-width: 360px;
    }

    .company-row {
        grid-template-columns: 160px 1fr;
        gap: 24px;
    }

    .vision-visual {
        max-width: 460px;
        margin: 0 auto;
    }

    .footer-grid {
        grid-template-columns: 1fr 1fr;
    }

    .footer-contact-card {
        grid-column: 1 / -1;
        min-height: 160px;
    }
}

@media (max-width: 900px) {
    .primary-nav,
    .contact-btn {
        display: none;
    }

    .menu-toggle {
        display: flex;
    }

    .vision-grid {
        grid-template-columns: 1fr;
        gap: 80px;
    }

    .vision-visual {
        max-width: 380px;
        margin: 0 auto;
    }

    .kw-1 { top: 12%; right: 8px; }
    .kw-2 { top: 48%; right: 0; }
    .kw-3 { top: 82%; right: 8px; }

    .kw-line { width: 36px !important; }

    .footer-nav-cols {
        grid-template-columns: 1fr 1fr;
    }

    .message-section,
    .company-section,
    .contact-section {
        padding: 90px 0 100px;
    }
}

@media (max-width: 720px) {
    :root {
        --gutter: 20px;
    }

    .header-inner {
        padding: 0 20px;
    }

    .hero-content {
        padding: calc(var(--header-h) + 32px) 20px 80px;
    }

    .hero-pagination,
    .scroll-indicator {
        display: none;
    }

    .hero-bg-image {
        right: -25%;
        width: 110%;
        opacity: 0.55;
    }

    .hero-bg-overlay {
        background:
            linear-gradient(180deg, rgba(2, 7, 20, 0.4) 0%, rgba(2, 7, 20, 0.85) 100%);
    }

    .service-section,
    .vision-section {
        padding: 80px 0 90px;
    }

    .service-grid,
    .service-grid.service-grid-3 {
        grid-template-columns: 1fr;
    }

    .sp-only { display: inline; }

    .ceo-portrait {
        max-width: 320px;
    }

    .ceo-portrait-caption {
        left: 18px;
        bottom: 18px;
    }

    .ceo-name-jp {
        font-size: 18px;
    }

    .vision-visual {
        max-width: 320px;
    }

    .kw {
        font-size: 11px;
    }

    .kw-line {
        width: 28px !important;
    }

    .company-row {
        grid-template-columns: 1fr;
        gap: 8px;
        padding: 22px 4px;
    }

    .company-row dt {
        font-size: 12px;
    }

    .contact-cta-btn {
        padding: 18px 28px;
        font-size: 14px;
    }

    .brand-logo {
        font-size: 16px;
    }

    .footer-grid {
        grid-template-columns: 1fr;
        gap: 48px;
    }

    .footer-nav-cols {
        grid-template-columns: 1fr 1fr;
    }

    .footer-bottom {
        flex-direction: column;
        align-items: flex-start;
    }

    .section-header {
        margin-bottom: 40px;
    }
}
